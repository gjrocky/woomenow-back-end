AWS_SECRET_ACCESS_KEY            # OPTIONAL | your SECRET_ACCESS_KEY | NEEDED if AWS_STORAGE_BUCKET_NAME
AWS_S3_REGION_NAME               # OPTIONAL | your selected S3 region | NEEDED if AWS_STORAGE_BUCKET_NAME

DEFAULT_FROM_EMAIL               # NEEDED IF DJANGO_DEBUG False | email address from which the mail will me sent
EMAIL_HOST_USER                  # NEEDED IF DJANGO_DEBUG False | email id from which the mail will me sent (login)
